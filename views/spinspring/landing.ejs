<%- include('../layouts/main') %>
<style>
:root {
  --ss-primary: #0284c7;
  --ss-secondary: #38bdf8;
  --ss-accent: #0ea5e9;
  --ss-light: #f0f9ff;
  --ss-white: #ffffff;
  --ss-dark: #0c4a6e;
  --ss-bg: #f8fafc;
}

body { background: var(--ss-bg); }

/* Hero Section */
.ss-hero {
  background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 50%, #38bdf8 100%);
  padding: 80px 0 100px;
  position: relative;
  overflow: hidden;
}
.ss-hero::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 500px;
  height: 500px;
  background: rgba(255,255,255,0.05);
  border-radius: 50%;
}
.ss-hero::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 400px;
  height: 400px;
  background: rgba(255,255,255,0.03);
  border-radius: 50%;
}
.ss-hero h1 {
  color: white;
  font-size: 3.5rem;
  font-weight: 800;
  margin-bottom: 15px;
  letter-spacing: -1px;
}
.ss-hero .tagline {
  color: rgba(255,255,255,0.9);
  font-size: 1.3rem;
  margin-bottom: 30px;
}
.ss-hero .hero-image {
  border-radius: 20px;
  box-shadow: 0 25px 60px rgba(0,0,0,0.3);
  overflow: hidden;
  background: white;
  min-height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ss-hero .hero-image i {
  font-size: 8rem;
  color: var(--ss-primary);
  opacity: 0.3;
}

/* Role Cards */
.role-section {
  margin-top: -50px;
  position: relative;
  z-index: 10;
}
.role-card {
  background: white;
  border-radius: 25px;
  padding: 35px 25px;
  text-align: center;
  box-shadow: 0 15px 40px rgba(2,132,199,0.15);
  transition: all 0.3s;
  border: 2px solid transparent;
  height: 100%;
}
.role-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 25px 60px rgba(2,132,199,0.25);
}
.role-card.owner { border-color: #0284c7; }
.role-card.attendant { border-color: #10b981; }
.role-card.customer { border-color: #f59e0b; }
.role-card .role-icon {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  font-size: 2.5rem;
  color: white;
}
.role-card.owner .role-icon { background: linear-gradient(135deg, #0284c7, #0ea5e9); }
.role-card.attendant .role-icon { background: linear-gradient(135deg, #10b981, #059669); }
.role-card.customer .role-icon { background: linear-gradient(135deg, #f59e0b, #d97706); }
.role-card h4 { color: var(--ss-dark); font-weight: 700; margin-bottom: 10px; }
.role-card p { color: #64748b; font-size: 0.9rem; margin-bottom: 20px; }

/* Features */
.feature-card {
  background: white;
  border-radius: 20px;
  padding: 30px;
  text-align: center;
  box-shadow: 0 5px 20px rgba(0,0,0,0.05);
  transition: all 0.3s;
  height: 100%;
}
.feature-card:hover { transform: translateY(-5px); box-shadow: 0 15px 40px rgba(0,0,0,0.1); }
.feature-card i { font-size: 3rem; color: var(--ss-primary); margin-bottom: 15px; }
.feature-card h5 { color: var(--ss-dark); font-weight: 700; }

/* Image Gallery Section */
.gallery-section { background: white; }
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
}
.gallery-item {
  position: relative;
  border-radius: 15px;
  overflow: hidden;
  cursor: pointer;
  min-height: 250px;
  background: var(--ss-light);
  border: 2px dashed #bae6fd;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.gallery-item .placeholder-icon {
  font-size: 4rem;
  color: #bae6fd;
}
.gallery-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(12,74,110,0.9));
  color: white;
  padding: 20px;
  opacity: 0;
  transition: opacity 0.3s;
}
.gallery-item:hover .gallery-overlay { opacity: 1; }

/* Stats */
.stat-number {
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--ss-primary);
}
.stat-label {
  color: #64748b;
  font-size: 0.9rem;
}

/* CTA Section */
.cta-section {
  background: linear-gradient(135deg, #0284c7, #0ea5e9);
  padding: 60px 0;
  text-align: center;
  color: white;
}

/* Responsive */
@media (max-width: 768px) {
  .ss-hero { padding: 60px 0 80px; }
  .ss-hero h1 { font-size: 2.2rem; }
  .role-section { margin-top: -30px; }
  .role-card { margin-bottom: 20px; }
}
</style>
</head>
<body>

<!-- Hero Section -->
<section class="ss-hero">
  <div class="container position-relative">
    <div class="row align-items-center">
      <div class="col-lg-6 mb-4 mb-lg-0">
        <span class="badge bg-white text-primary mb-3 px-3 py-2 rounded-pill" style="color:#0284c7 !important;">
          <i class="fas fa-star me-1"></i> Smart Laundry Automation
        </span>
        <h1>SpinSpring</h1>
        <p class="tagline">Revolutionize your laundry business with IoT-powered washing machines, real-time monitoring, and smart order management.</p>
        <div class="d-flex flex-wrap gap-2">
          <a href="/spinspg/login" class="btn btn-light btn-lg rounded-pill fw-bold">
            <i class="fas fa-sign-in-alt me-2"></i> Get Started
          </a>
          <a href="#roles" class="btn btn-outline-light btn-lg rounded-pill">
            <i class="fas fa-arrow-down me-2"></i> Learn More
