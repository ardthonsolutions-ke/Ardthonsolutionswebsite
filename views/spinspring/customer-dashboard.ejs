<%- include('../layouts/main') %>
<style>
.ss-nav { background: linear-gradient(135deg, #f59e0b, #d97706); padding: 15px 0; }
.ss-nav a { color: white !important; text-decoration: none; }
.ss-card {
  background: white;
  border-radius: 20px;
  padding: 25px;
  box-shadow: 0 5px 25px rgba(245,158,11,0.1);
  border: 1px solid #fef3c7;
  margin-bottom: 20px;
}
.customer-badge {
  background: #fef3c7;
  color: #92400e;
  padding: 10px 20px;
  border-radius: 15px;
  font-family: monospace;
  font-size: 1.2rem;
  font-weight: 700;
  display: inline-block;
}
</style>
</head>
<body>
<nav class="ss-nav">
  <div class="container d-flex justify-content-between align-items-center">
    <a href="/spinspg/customer" class="brand text-white text-decoration-none" style="font-size:1.5rem;font-weight:800;">
      <i class="fas fa-soap me-2"></i>SpinSpring
    </a>
    <div>
      <span class="text-white me-2">Welcome, <%= customer.full_name %></span>
      <a href="/spinspg/logout" class="btn btn-danger btn-sm rounded-pill">Logout</a>
    </div>
  </div>
</nav>

<div class="container py-4">
  <!-- Customer Card -->
  <div class="ss-card text-center">
    <i class="fas fa-user-circle fa-4x mb-3" style="color:#f59e0b;"></i>
    <h4 style="color:#0c4a6e;"><%= customer.full_name %></h4>
    <div class="customer-badge"><%= customer.customer_unique_id %></div>
    <div class="row mt-4">
      <div class="col-4">
        <div class="h4 fw-bold text-success"><%= customer.total_cycles %></div>
        <small class="text-muted">Total Cycles</small>
      </div>
      <div class="col-4">
        <div class="h4 fw-bold">Ksh <%= customer.total_spent %></div>
        <small class="text-muted">Total Spent</small>
      </div>
      <div class="col-4">
        <div class="h4 fw-bold text-warning"><%= customer.loyalty_points %></div>
        <small class="text-muted">Loyalty Points</small>
      </div>
    </div>
    <div class="mt-3">
      <span class="badge bg-warning text-dark">Tier: <%= customer.tier.toUpperCase() %></span>
    </div>
  </div>

  <!-- My Orders -->
  <div class="ss-card">
    <h5 class="mb-3" style="color:#0c4a6e;">My Orders</h5>
    <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead><tr><th>Order #</th><th>Service</th><th>Status</th><th>Price</th><th>Date</th></tr></thead>
          <tbody>
            <% orders.forEach(function(o) { %>
              <tr>
                <td style="font-size:0.8rem;"><%= o.order_number %></td>
                <td><%= o.service_type.replace('_', ' ') %></td>
                <td><span class="badge bg-info"><%= o.order_status %></span></td>
                <td>Ksh <%= o.price %></td>
                <td style="font-size:0.75rem;"><%= new Date(o.created_at).toLocaleDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-muted">No orders yet</p>
    <% } %>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>